// =============================================================================
// Srusti Academy of Management and Technology — College Portal
// Prisma Schema — PostgreSQL 15
// =============================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  DEPT_ADMIN
  FACULTY
  STUDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum PlacementStatus {
  APPLIED
  SHORTLISTED
  INTERVIEW
  SELECTED
  REJECTED
}

enum GalleryCategory {
  EVENTS
  CAMPUS
  CULTURAL
  SPORTS
}

enum InquiryStatus {
  NEW
  IN_REVIEW
  CONTACTED
  CLOSED
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  name         String     @default("User")
  passwordHash String
  role         UserRole   @default(STUDENT)
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  refreshTokens RefreshToken[]
  student       Student?
  faculty       Faculty?
  adminProfile  AdminProfile?
  notifications Notification[]
  auditLogs     AuditLog[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
}

model Department {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courses       Course[]
  students      Student[]
  faculty       Faculty[]
  adminProfiles AdminProfile[]
}

model Course {
  id            String     @id @default(uuid())
  name          String
  slug          String     @unique
  code          String?    @unique
  departmentId  String
  department    Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  durationYears Int
  eligibility   String
  totalFees     Float
  description   String
  syllabusUrl   String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  subjects Subject[]
  students Student[]
}

model Subject {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  semester  Int
  credits   Int      @default(3)
  facultyId String?
  faculty   Faculty? @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendanceRecords AttendanceRecord[]
  results           Result[]
}

model Faculty {
  id           String     @id @default(uuid())
  userId       String     @unique
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  designation  String
  phone        String?
  bio          String?
  photoUrl     String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  subjects Subject[]
}

model Student {
  id              String     @id @default(uuid())
  userId          String     @unique
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  regNo           String     @unique
  departmentId    String
  department      Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  courseId        String
  course          Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  currentSemester Int        @default(1)
  enrollmentYear  Int
  phone           String?
  cgpa            Float      @default(0.0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  attendanceRecords     AttendanceRecord[]
  results               Result[]
  eventRegistrations    EventRegistration[]
  placementApplications PlacementApplication[]
}

model AdminProfile {
  id           String      @id @default(uuid())
  userId       String      @unique
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation  String      @default("Administrator")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model AttendanceRecord {
  id        String           @id @default(uuid())
  studentId String
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  date      String
  status    AttendanceStatus
  remarks   String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([studentId, subjectId, date])
}

model Result {
  id            String   @id @default(uuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId     String
  subject       Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  semester      Int
  internalMarks Float
  externalMarks Float
  totalMarks    Float
  grade         String
  credits       Int      @default(3)
  isPublished   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([studentId, subjectId, semester])
}

model Event {
  id                 String   @id @default(uuid())
  title              String
  description        String
  category           String
  eventDate          String
  time               String
  venue              String
  capacity           Int
  bannerUrl          String?
  isRegistrationOpen Boolean  @default(true)
  isPublished        Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  registrations EventRegistration[]
}

model EventRegistration {
  id           String   @id @default(uuid())
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  registeredAt DateTime @default(now())

  @@unique([eventId, studentId])
}

model Company {
  id          String   @id @default(uuid())
  name        String   @unique
  website     String?
  logoUrl     String?
  industry    String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  placementDrives PlacementDrive[]
}

model PlacementDrive {
  id              String   @id @default(uuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobRole         String
  ctcPackage      String
  eligibleCourses String
  minCgpa         Float    @default(6.0)
  driveDate       String
  location        String
  description     String
  deadline        String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  applications PlacementApplication[]
}

model PlacementApplication {
  id        String          @id @default(uuid())
  driveId   String
  drive     PlacementDrive  @relation(fields: [driveId], references: [id], onDelete: Cascade)
  studentId String
  student   Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status    PlacementStatus @default(APPLIED)
  notes     String?
  appliedAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([driveId, studentId])
}

model Announcement {
  id        String    @id @default(uuid())
  title     String
  content   String
  category  String    @default("General")
  isPinned  Boolean   @default(false)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model GalleryItem {
  id        String          @id @default(uuid())
  title     String
  category  GalleryCategory
  imageUrl  String
  caption   String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model Inquiry {
  id               String        @id @default(uuid())
  name             String
  email            String
  phone            String
  courseOfInterest String?
  message          String
  type             String        @default("GENERAL")
  status           InquiryStatus @default(NEW)
  isRead           Boolean       @default(false)
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id             String   @id @default(uuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  role           String
  action         String
  targetResource String
  details        String?
  ipAddress      String?
  createdAt      DateTime @default(now())
}
